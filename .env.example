# ===== Servidor =====
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ===== Banco de dados =====
# Por padrão o projeto usa um banco LOCAL embutido: os dados ficam na pasta server/data
# (nada para instalar, nenhum serviço externo). Apague a pasta server/data para voltar ao zero.
# Só mude para false se um dia quiser usar um MongoDB externo (local/Atlas) via MONGODB_URI.
USE_LOCAL_DB=true
MONGODB_URI=mongodb://127.0.0.1:27017/restaurante

# ===== Autenticação =====
# Gere um segredo longo e aleatório:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-segredo-por-um-valor-longo-e-aleatorio
JWT_EXPIRES_IN=8h

# ===== Administrador inicial (criado na primeira execução, se não houver usuários) =====
# Credenciais APENAS para desenvolvimento/demonstração.
ADMIN_EMAIL=admin@restaurante.local
ADMIN_PASSWORD=Admin@123456

# ===== WhatsApp (DDI + DDD + número, só dígitos). Também editável no painel. =====
WHATSAPP_NUMBER=
